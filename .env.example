# ===== YouTube Bulk Scheduler Configuration =====

# Server
PORT=8000
NODE_ENV=development

# YouTube OAuth2 Credentials (Primary)
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/youtube/callback

# Google OAuth2 Credentials (Fallback)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=your_google_redirect_uri

# Upload Settings
MAX_CONCURRENT_UPLOADS=2
UPLOAD_CHUNK_SIZE_MB=16
MAX_FILE_SIZE_GB=20
UPLOAD_RETRY_ATTEMPTS=5
UPLOAD_RETRY_DELAY_MS=3000

# Storage Paths
STORAGE_BASE_PATH=./storage
TOKENS_PATH=./storage/tokens
UPLOADS_PATH=./storage/uploads
SCHEDULES_PATH=./storage/schedules
THUMBNAILS_PATH=./storage/thumbnails

# Upload temp directory
UPLOAD_TEMP_PATH=./uploads

# Scheduler
SCHEDULER_CRON=*/1 * * * *

# VieNeu-TTS Local Server
VIENEU_SERVER_URL=http://localhost:8020

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# API key 9router
API_KEY_9ROUTER=your_api_key_9router

# 9Router Password (default dashboard password)
PASSWORD_9ROUTER=123456

# ===== Proxy Configuration =====
PROXY_COUNT=2
YTDLP_PROXY_1=socks5://user:pass@ip1:port
YTDLP_PROXY_2=socks5://user:pass@ip2:port

# ===== Cookies Configuration (bypass YouTube 403) =====
# Dùng 1 trong 2 cách (ưu tiên BROWSER nếu cả 2 cùng set)
# Cách 1: Browser trực tiếp (chrome, firefox, edge, safari, brave, chromium)
# YTDLP_COOKIES_FROM_BROWSER=chrome
# Cách 2: File cookies.txt (export bằng extension "Get cookies.txt LOCALLY")
# YTDLP_COOKIES_FILE=./cookies.txt

