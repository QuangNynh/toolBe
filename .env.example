# ────────────────────────────────────────────
# Server Configuration
# ────────────────────────────────────────────
PORT=8000

# ────────────────────────────────────────────
# Google Gemini AI (Translation Module)
# ────────────────────────────────────────────
# Get your API key at: https://aistudio.google.com/apikey
# Optional if you pass apiKey in each request
GEMINI_API_KEY=

# ────────────────────────────────────────────
# XTTS v2 Server (Audio TTS Module)
# ────────────────────────────────────────────
# URL of the Python XTTS v2 server (must be running separately)
# Change port if it conflicts with Proxy module (also uses 8888)
XTTS_SERVER_URL=http://localhost:8888
